{
  "name": "DB Delay Intelligence",
  "dataColors": ["#2563EB", "#1E8E3E", "#F9AB00", "#D93025", "#6B7280", "#7C3AED", "#0891B2", "#E8710A"],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#2563EB",
  "good": "#1E8E3E",
  "neutral": "#F9AB00",
  "bad": "#D93025",
  "minimum": "#1E8E3E",
  "center": "#F9AB00",
  "maximum": "#D93025",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#374151" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E5E7EB" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F2937" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold" }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F5F6F8" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F5F6F8" } }, "transparency": 0 }]
      }
    }
  }
}
