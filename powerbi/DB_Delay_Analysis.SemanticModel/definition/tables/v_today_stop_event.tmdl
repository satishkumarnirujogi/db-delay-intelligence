	partition v_today_stop_event = m
		mode: directQuery
		source =
				let
				    Source = PostgreSQL.Database("aws-1-eu-central-1.pooler.supabase.com:5432", "postgres"),
				    marts_v_today_stop_event = Source{[Schema="marts",Item="v_today_stop_event"]}[Data],
				    f1 = Table.AddColumn(marts_v_today_stop_event, "f_departed", each if [is_departed] = true then 1 else 0, Int64.Type),
				    f2 = Table.AddColumn(f1, "f_departed_not_cancelled", each if [is_departed] = true and [is_cancelled] = false then 1 else 0, Int64.Type),
				    f3 = Table.AddColumn(f2, "f_on_time", each if [is_departed] = true and [is_punctual] = true then 1 else 0, Int64.Type),
				    f4 = Table.AddColumn(f3, "f_cancelled", each if [is_departed] = true and [is_cancelled] = true then 1 else 0, Int64.Type),
				    f5 = Table.AddColumn(f4, "f_live", each if [is_departed] = true and [has_realtime] = true then 1 else 0, Int64.Type),
				    f6 = Table.AddColumn(f5, "f_platform_changed", each if [platform_changed] = true then 1 else 0, Int64.Type),
				    f7 = Table.AddColumn(f6, "f_delay_value", each if [is_departed] = true and [is_cancelled] = false then [dep_delay_min] else null, Int64.Type),
				    f8 = Table.AddColumn(f7, "f_delay_count", each if [is_departed] = true and [is_cancelled] = false and [dep_delay_min] <> null then 1 else 0, Int64.Type)
				in
				    f8

	changedProperty = Name

	annotation PBI_ResultType = Table

